# ─────────────────────────────────────────────────────────────
#  Promasidor — configuration du serveur (copier en .env)
#  Ne JAMAIS committer le fichier .env (il est dans .gitignore)
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Base PostgreSQL (utilisateur dédié, droits limités à cette base)
DATABASE_URL=postgres://promasidor_app:MOT_DE_PASSE_FORT@127.0.0.1:5432/promasidor

# Générer ces 3 valeurs avec : npm run gen-secrets
SESSION_SECRET=
ENCRYPTION_KEY=
IP_HASH_SALT=

# Chemin de l'espace admin : non devinable, commence par /
ADMIN_PATH=/gestion-changez-moi

# Optionnel : n'autoriser l'admin que depuis certaines IP (séparées par des virgules)
# ADMIN_IP_ALLOWLIST=41.111.22.33,105.98.0.1
ADMIN_IP_ALLOWLIST=

# Domaine public du site (utilisé pour vérifier l'origine des requêtes)
PUBLIC_ORIGIN=https://www.promasidor-dz.com

# Nombre de proxys devant Node (1 = Nginx)
TRUST_PROXY=1
